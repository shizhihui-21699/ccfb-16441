{
    "name": "tplguard/tplguard",
    "description": "Server-side template injection detection and hardened compiled-template engine for legacy PHP forum software",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "TplGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TplGuard\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
